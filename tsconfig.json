{
  "compilerOptions": {
    "strict": true,
    "target": "ES2020",
    "module": "commonjs",
    "outDir": "dist",
    "declaration": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": [
    "nodes/**/*",
    "credentials/**/*",
    "transport/**/*"
  ],
  "exclude": [
    "**/*.test.ts"
  ]
}
